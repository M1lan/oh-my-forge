#!/opt/homebrew/bin/bash
# monty-llm — have a LOCAL ollama model write Python, run it in the monty sandbox.
#
# Generation (local model) and execution (monty, no net/fs/subprocess access)
# both stay on this machine. Part of the monty-playground skill
# (~/forge/skills/monty-playground/).
#
# Usage: monty-llm [-m MODEL] [-t SECS] [-M MEM] [-s] [-k] 'task description'

set -euo pipefail
shopt -s inherit_errexit

readonly DEFAULT_MODEL="${MONTY_LLM_MODEL:-ornith:latest}"

usage() {
  cat <<'EOF'
monty-llm — local ollama model writes Python, monty sandbox runs it.

usage: monty-llm [options] 'task description'
  -m MODEL   ollama model (default: $MONTY_LLM_MODEL or ornith:latest)
  -t SECS    monty --max-duration (default: 5)
  -M MEM     monty --max-memory (default: 256MB)
  -s         show the generated code before running it
  -k         keep the generated file (path is printed)
  -h         this help
EOF
}

main() {
  local model="$DEFAULT_MODEL" max_secs=5 max_mem=256MB show=0 keep=0
  local opt
  while getopts ':m:t:M:skh' opt; do
    case "$opt" in
      m) model="$OPTARG" ;;
      t) max_secs="$OPTARG" ;;
      M) max_mem="$OPTARG" ;;
      s) show=1 ;;
      k) keep=1 ;;
      h)
        usage
        exit 0
        ;;
      :) die "option -$OPTARG requires an argument" ;;
      *) die "unknown option -$OPTARG (see -h)" ;;
    esac
  done
  shift $((OPTIND - 1))
  (($# >= 1)) || {
    usage
    exit 2
  }
  local task="$*"

  command -v monty >/dev/null || die "monty not on PATH (cargo install --path ~/mysrc/monty/crates/monty-cli)"
  command -v ollama >/dev/null || die "ollama not on PATH"

  local code
  code=$(generate_code "$model" "$task")
  [[ -n $code ]] || die "model returned no code"

  mkdir -p "$HOME/tmp"
  local script
  script=$(mktemp "$HOME/tmp/monty-llm.XXXXXX.py")
  printf '%s\n' "$code" >"$script"

  ((show)) && {
    printf '── generated by %s ──\n' "$model" >&2
    cat "$script" >&2
    printf '── monty run ──\n' >&2
  }

  local rc=0
  monty --max-duration "$max_secs" --max-memory "$max_mem" "$script" || rc=$?

  if ((keep)) || ((rc != 0)); then
    printf 'generated file: %s\n' "$script" >&2
  else
    rm -f "$script"
  fi
  return "$rc"
}

# Ask the local model for a plain Python script, constrained to monty's
# stdlib subset; strip markdown fences if the model adds them anyway.
generate_code() {
  local model="$1" task="$2"
  local prompt
  prompt="Write a single self-contained Python script for this task: ${task}

Hard constraints (the monty sandbox interpreter, NOT full CPython):
- Only these modules exist: asyncio, datetime, json, math, os, pathlib, re, sys, typing.
- collections/functools/itertools/random/time/io/struct/hashlib do NOT exist. namedtuple and the dataclass decorator are builtins (no import needed).
- No file, network, or subprocess access. No input(). Print results with print().
Reply with ONLY the Python code. No markdown fences, no explanation."

  # --hidethinking suppresses reasoning-model think blocks where supported;
  # strip_noise catches them anyway on older ollama versions.
  if ollama run --help 2>/dev/null | rg -q -- '--hidethinking'; then
    ollama run --hidethinking "$model" "$prompt" 2>/dev/null | strip_noise
  else
    ollama run "$model" "$prompt" 2>/dev/null | strip_noise
  fi
}

# Remove ```python ... ``` fencing and "Thinking... / ...done thinking."
# blocks (models often ignore "no fences"; reasoning models leak thoughts).
strip_noise() {
  local -a lines=()
  mapfile -t lines
  local -a out=()
  local line thinking=0
  for line in "${lines[@]}"; do
    if [[ $line == 'Thinking...'* ]]; then
      thinking=1
      continue
    fi
    if ((thinking)); then
      [[ $line == *'...done thinking.'* ]] && thinking=0
      continue
    fi
    [[ $line == '```'* ]] && continue
    out+=("$line")
  done
  printf '%s\n' "${out[@]}"
}

die() {
  printf 'monty-llm: %s\n' "$*" >&2
  exit 1
}

main "$@"
