root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space

[*.{toml,yaml,yml,json}]
indent_size = 2

# Markdown indentation is structural (nested lists, fenced code blocks with
# arbitrary inner indentation, tab-indented examples). Enforcing indent rules
# produces false positives — rumdl owns Markdown style instead.
[*.md]
indent_style = unset
indent_size = unset

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
